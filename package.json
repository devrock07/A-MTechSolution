{
  "name": "am-tech-solutions-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "preview": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "assets:social": "node scripts/social-card.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "qa:browser": "playwright test",
    "verify": "npm run check && npm test && npm run qa:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
